-- Generates src/ReplicatedStorage/Modules/Traffic/TrafficRoutes.luau (NPC
-- circuits, keep-clear boxes, lane-change boxes, static obstacles) from the
-- same Layout the map is built from, so the traffic always matches the roads.
--
-- Circuits live INSIDE a zone and never cross a permit gate (an NPC car
-- driving through a boom that is down for the player watching looks broken).
-- Market Ave carries most cars, concentrated in the MIDDLE of each zone: the
-- stretch by the Terminal gate (Terminal Rd .. Brick St) is deliberately
-- light, so a player leaving the yard can always get out.

local L = require(script.Parent.Layout)

local Traffic = {}

local M = L.MarketLanes
local S = L.StreetLanes

local function laneOff(road)
	return road.w / 2 - 11
end
local function wb(road) -- westbound lane (north half)
	return road.zc - laneOff(road)
end
local function eb(road) -- eastbound lane (south half)
	return road.zc + laneOff(road)
end

-- NB side x, SB side x, south turn road, north turn road
local function shuttle(xN, xS, low, high)
	local mid = (eb(low) + wb(high)) / 2
	return { { xN, mid }, { xN, wb(high) }, { xS, wb(high) }, { xS, eb(low) }, { xN, eb(low) }, { xN, mid } }
end
local function ring(low, high)
	local mid = (eb(low) + wb(high)) / 2
	return { { S.EastNB, mid }, { S.EastNB, wb(high) }, { S.WestSB, wb(high) }, { S.WestSB, eb(low) }, { S.EastNB, eb(low) }, { S.EastNB, mid } }
end
local function block(low, high)
	local mid = (eb(low) + wb(high)) / 2
	return { { S.WestNB, mid }, { S.WestNB, eb(high) }, { S.EastSB, eb(high) }, { S.EastSB, wb(low) }, { S.WestNB, wb(low) }, { S.WestNB, mid } }
end

local CIRCUITS = {
	OldTown = function(R)
		return {
			{ "OldTownMarket", 28, shuttle(M.NBOuter, M.SBOuter, R[2], R[4]), 12 },
			{ "OldTownMarketMid", 12, shuttle(M.NBInner, M.SBInner, R[2], R[3]), -12 },
			{ "OldTownMarketNorth", 10, shuttle(M.NBInner, M.SBInner, R[3], R[4]), -12 },
			{ "OldTownMarketSouth", 4, shuttle(M.NBInner, M.SBInner, R[1], R[2]), -12 },
			{ "OldTownRing", 8, ring(R[1], R[4]) },
			{ "OldTownBlockSouth", 6, block(R[1], R[2]) },
			{ "OldTownBlockMid", 8, block(R[2], R[3]) },
		}
	end,
	Mill = function(R)
		return {
			{ "MillMarket", 18, shuttle(M.NBOuter, M.SBOuter, R[2], R[4]), 12 },
			{ "MillMarketSouth", 5, shuttle(M.NBInner, M.SBInner, R[1], R[2]), -12 },
			{ "MillMarketInner", 7, shuttle(M.NBInner, M.SBInner, R[2], R[3]), -12 },
			{ "MillRing", 7, ring(R[1], R[4]) },
			{ "MillBlock", 6, block(R[2], R[3]) },
		}
	end,
	Harbour = function(R)
		return {
			{ "HarbourMarket", 11, shuttle(M.NBOuter, M.SBOuter, R[1], R[3]), 12 },
			{ "HarbourRing", 6, ring(R[1], R[3]) },
		}
	end,
}

-- A circuit segment that runs straight across a roundabout junction (a U-turn
-- across Market, or a ring/block circuit crossing it) would drive over the
-- island, so it is bent round the near side of it: out along the lane, round a
-- half circle at Radius + Kerb + CarHalf, back onto the lane. `spec.Roundabouts`
-- says which junctions; points are in the zone's local frame, {x, z}.
local function detour(points, spec)
	if not spec.Roundabouts then
		return points
	end
	local RB = L.Roundabout
	local result = {}
	for i, a in points do
		table.insert(result, a)
		local b = points[i + 1]
		if not b or math.abs(a[2] - b[2]) > 0.01 or a[1] * b[1] >= 0 then
			continue -- only a level segment that crosses x = 0 can meet the island
		end
		for _, ra in spec.Roundabouts do
			local cz = spec.CrossRoads[ra.road].zc
			local pass = (ra.radius or RB.Radius) + RB.Kerb + RB.CarHalf
			local dz = a[2] - cz
			if math.abs(dz) >= pass then
				continue -- runs outside the island already
			end
			if math.abs(a[1]) < pass + 5 or math.abs(b[1]) < pass + 5 then
				warn(string.format("Traffic.detour: no room to bend a %s crossing at z %.0f round its roundabout", spec.Key, a[2]))
				continue
			end
			local d = b[1] > a[1] and 1 or -1 -- direction of travel along x
			local s = dz >= 0 and 1 or -1 -- which side of the island it passes
			local c = 0.7071 * pass
			for _, w in {
				{ -d * (pass + 4), a[2] }, { -d * c, cz + s * c }, { 0, cz + s * pass }, { d * c, cz + s * c }, { d * (pass + 4), a[2] },
			} do
				table.insert(result, w)
			end
		end
	end
	return result
end

local function fmt(n)
	local s = string.format("%.1f", n):gsub("%.0$", "")
	return s
end

local function worldRect(frame, r)
	local a = frame * Vector3.new(r.x1, 0, r.z1)
	local b = frame * Vector3.new(r.x2, 0, r.z2)
	return math.min(a.X, b.X), math.min(a.Z, b.Z), math.max(a.X, b.X), math.max(a.Z, b.Z)
end

-- zones = { { spec, result } } (results from Zone.Build, local space)
function Traffic.Source(zones)
	local lines = {
		"-- GENERATED by tools/mapgen/Traffic.luau from tools/mapgen/Layout.luau.",
		"-- Do not edit by hand: change the layout and regenerate the city.",
		"-- Coordinates are world X/Z.",
		"",
		"local R = {}",
		"",
		"R.Routes = {",
	}
	for _, z in zones do
		local spec, res = z.spec, z.result
		local roads = {}
		for _, cr in spec.CrossRoads do
			table.insert(roads, cr)
		end
		local boxes = {}
		for _, r in res.marketStretches do
			local x1, z1, x2, z2 = worldRect(spec.Frame, r)
			table.insert(boxes, string.format("{ %s, %s, %s, %s }", fmt(x1), fmt(z1), fmt(x2), fmt(z2)))
		end
		for _, c in CIRCUITS[spec.Key](roads) do
			local pts = {}
			for _, p in detour(c[3], spec) do
				local w = spec.Frame * Vector3.new(p[1], 0, p[2])
				table.insert(pts, string.format("{ %s, %s }", fmt(w.X), fmt(w.Z)))
			end
			table.insert(lines, "\t{")
			table.insert(lines, string.format("\t\tName = %q,", c[1]))
			table.insert(lines, string.format("\t\tCap = %d,", c[2]))
			table.insert(lines, "\t\tClosed = true,")
			table.insert(lines, "\t\tPoints = { " .. table.concat(pts, ", ") .. " },")
			if c[4] then
				-- positive = the lane to the car's LEFT
				table.insert(lines, string.format("\t\tLanes = { Offset = %d, Boxes = { %s } },", c[4], table.concat(boxes, ", ")))
			end
			table.insert(lines, "\t},")
		end
	end
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "R.KeepClear = {")
	for _, z in zones do
		local spec, res = z.spec, z.result
		local function add(r, name)
			local x1, z1, x2, z2 = worldRect(spec.Frame, r)
			table.insert(lines, string.format("\t{ %s, %s, %s, %s, %q },", fmt(x1), fmt(z1), fmt(x2), fmt(z2), name))
		end
		for _, j in res.junctions do
			add(j.rect, j.name)
		end
		for _, m in res.mouths do
			local r
			if m.road == "Market" then
				r = { x1 = L.Market.x1, x2 = L.Market.x2, z1 = m.z - m.w / 2 - 3, z2 = m.z + m.w / 2 + 3 }
			elseif m.road == "West" then
				r = { x1 = L.WestSt.x1, x2 = L.WestSt.x2, z1 = m.z - m.w / 2 - 3, z2 = m.z + m.w / 2 + 3 }
			elseif m.road == "East" then
				r = { x1 = L.EastSt.x1, x2 = L.EastSt.x2, z1 = m.z - m.w / 2 - 3, z2 = m.z + m.w / 2 + 3 }
			else
				for _, rd in res.roads do
					if math.abs(rd.rect.z1 - m.z) < 0.6 or math.abs(rd.rect.z2 - m.z) < 0.6 then
						r = { x1 = m.x - m.w / 2 - 3, x2 = m.x + m.w / 2 + 3, z1 = rd.rect.z1, z2 = rd.rect.z2 }
					end
				end
			end
			if r then
				add(r, m.name .. " (" .. m.road .. ")")
			end
		end
		for _, d in spec.Destinations do
			local r = { x1 = d.rect[1], z1 = d.rect[2], x2 = d.rect[3], z2 = d.rect[4] }
			local box
			if d.access == "W" then
				box = { x1 = r.x1 - 80, x2 = r.x1, z1 = r.z1 - 3, z2 = r.z2 + 3 }
			elseif d.access == "E" then
				box = { x1 = r.x2, x2 = r.x2 + 80, z1 = r.z1 - 3, z2 = r.z2 + 3 }
			elseif d.access == "S" then
				box = { x1 = r.x1 - 3, x2 = r.x2 + 3, z1 = r.z2, z2 = r.z2 + 40 }
			else
				box = { x1 = r.x1 - 3, x2 = r.x2 + 3, z1 = r.z1 - 40, z2 = r.z1 }
			end
			add(box, d.Name)
		end
	end
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "-- Things parked in a lane for good (roadworks): NPC cars treat them as")
	table.insert(lines, "-- obstacles and change lanes round them.")
	table.insert(lines, "R.Static = {")
	for _, z in zones do
		for _, r in z.result.roadworks do
			local x1, z1, x2, z2 = worldRect(z.spec.Frame, r)
			table.insert(lines, string.format("\t{ %s, %s, %s, %s },", fmt(x1), fmt(z1), fmt(x2), fmt(z2)))
		end
	end
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "return R")
	table.insert(lines, "")
	return table.concat(lines, "\n")
end

return Traffic
